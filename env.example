# General runtime
# DEBUG="true"
# NETWORK="true"

# Signer behavior
AUTO_ROTATE=true
KEYSET_EXPIRY_HOURS=320

# Optional web UI
ENABLE_WEB_UI=false
WEB_UI_ADDR=127.0.0.1:8080

# gRPC server TLS files
# Used by the signer server itself when accepting mTLS connections
TLS_SERVER_CERT_PATH=tls/server-cert.pem
TLS_SERVER_KEY_PATH=tls/server-key.pem

# Certificate authority files
# CA cert is used to verify client certs
# CA key is used by the web UI/account manager to issue new account client certs
TLS_CA_CERT_PATH=tls/ca-cert.pem
TLS_CA_KEY_PATH=tls/ca-key.pem

# Per-account client certificate output directory
# Leave empty to use the default config directory certificates path
ACCOUNT_TLS_DIR=

# Signer mnemonic
# If not provided, one is securely generated and stored
MNEMONIC=""
